# Normalize line endings in the repository (LF), convert on checkout where needed.
* text=auto eol=lf

# Windows scripts must have CRLF to work reliably in cmd/PowerShell 5.1
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts must stay LF (used in the devcontainer / on the Linux server)
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.pdf binary
*.bin binary
*.elf binary
*.der binary
