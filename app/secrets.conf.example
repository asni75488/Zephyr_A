# Zephyr_A - secrets template
#
# Copy to app/secrets.conf (ignored by git) and fill in real values:
#   Copy-Item app\secrets.conf.example app\secrets.conf
# Build with:
#   .\scripts\build.ps1 -ExtraConf app\secrets.conf
#
# NEVER commit app/secrets.conf.
# The Kconfig symbols below are placeholders; they are defined in the parts
# where they are used (cellular: part 4, MQTT: part 6).

# --- Cellular (part 4) ----------------------------------------------------
# Onomondo SIM: no PIN. APN is not secret but kept here so it is easy to change.
# CONFIG_APP_CELLULAR_APN="onomondo"

# --- MQTT broker (part 6) -------------------------------------------------
# CONFIG_APP_MQTT_BROKER_HOST="zephyra.vps.webdock.cloud"
# CONFIG_APP_MQTT_USERNAME="device-user"
# CONFIG_APP_MQTT_PASSWORD="change-me"
