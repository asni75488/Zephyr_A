# Zephyr_A - secrets template
#
# Copy to app/secrets.conf (ignored by git) and fill in the real values:
#   Copy-Item app\secrets.conf.example app\secrets.conf
#   notepad app\secrets.conf
# scripts\build.ps1 adds app\secrets.conf automatically when it exists.
#
# NEVER commit app/secrets.conf. The values end up in the firmware image and
# in build\ (also ignored by git); protecting them on the device (flash
# encryption) is part 8.

# --- MQTT broker (part 6) -------------------------------------------------
# Password of the MQTT user created on the server with
#   sudo bash ~/Zephyr_A/cloud/scripts/60-add-device.sh esp32c6-14c19fe0ab24
# The user name defaults to the device id (printed at boot: "Device id: ...")
# and must match the user created on the server (ACL: user = edge node id).
CONFIG_APP_MQTT_PASSWORD="change-me"
# CONFIG_APP_MQTT_USERNAME="esp32c6-14c19fe0ab24"

# --- Cellular (part 4) ----------------------------------------------------
# Onomondo SIM: no PIN, APN "onomondo" without login (set in prj.conf).
