# Zephyr_A - embed trusted root CA certificates (DER) in the firmware.
#
# zephyr_a_add_ca_certs(<target> <der-file>...)
#
# Generates include/generated/zephyr_a_ca/ca_list.h with one const array per
# certificate and a table { name, data, len }. The arrays stay in flash and
# are handed to TLS with TLS_CERT_NOCOPY, so no RAM copy is made.
# Used by app/CMakeLists.txt (ISRG roots) and app/tests/mqtt_tls (test CA).
#
# SPDX-License-Identifier: Apache-2.0

function(zephyr_a_add_ca_certs target)
  if(NOT ARGN)
    message(FATAL_ERROR "zephyr_a_add_ca_certs: no certificate files given")
  endif()

  set(gen_dir ${ZEPHYR_BINARY_DIR}/include/generated/zephyr_a_ca)
  set(arrays "")
  set(entries "")
  set(idx 0)

  foreach(der IN LISTS ARGN)
    if(NOT EXISTS ${der})
      message(FATAL_ERROR "CA certificate not found: ${der}")
    endif()
    get_filename_component(name ${der} NAME_WE)
    generate_inc_file_for_target(${target} ${der} ${gen_dir}/ca_${idx}.inc)
    string(APPEND arrays
      "static const uint8_t ca_der_${idx}[] = {\n#include \"zephyr_a_ca/ca_${idx}.inc\"\n};\n")
    string(APPEND entries "\t{\"${name}\", ca_der_${idx}, sizeof(ca_der_${idx})},\n")
    math(EXPR idx "${idx} + 1")
  endforeach()

  file(CONFIGURE OUTPUT ${gen_dir}/ca_list.h CONTENT
"/* Generated by app/cmake/ca_certs.cmake - do not edit. */
#include <stddef.h>
#include <stdint.h>

struct zephyr_a_ca {
\tconst char *name;
\tconst uint8_t *der;
\tsize_t len;
};

${arrays}
static const struct zephyr_a_ca zephyr_a_ca_list[] = {
${entries}};
")
endfunction()
