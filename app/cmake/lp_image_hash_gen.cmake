# Writes OUT (C source) with the SHA-256 and size of IN (LP zephyr.bin).
file(SHA256 ${IN} hash)
file(SIZE ${IN} size)
string(REGEX REPLACE "(..)" "0x\\1, " bytes "${hash}")
file(WRITE ${OUT}
"/* Generated by app/cmake/lp_image_hash_gen.cmake - do not edit */\n"
"#include <stddef.h>\n#include <stdint.h>\n\n"
"const uint8_t zephyr_a_lp_image_sha256[32] = {${bytes}};\n"
"const size_t zephyr_a_lp_image_size = ${size};\n")
