#
# Zephyr_A - device client certificate + private key for mTLS (part 10).
#
# zephyr_a_add_client_cert(<target> <cert.der> <key.der>)
#
# The files come from scripts/device_pki.py (certs/device-pki/devices/, ignored
# by git) and are selected by scripts/build.ps1 -Mtls through
# CONFIG_APP_MQTT_CLIENT_CERT_FILE / CONFIG_APP_MQTT_CLIENT_KEY_FILE.
# The generated header lies in the build directory (also ignored by git).
# The private key ends up in the firmware image in plain text, like the MQTT
# password before; protecting it needs flash encryption (docs/08 section 7)
# or the ESP32-C6 Digital Signature peripheral (docs/10 section 3.6).

function(zephyr_a_add_client_cert target cert key)
  foreach(f IN ITEMS ${cert} ${key})
    if(NOT EXISTS "${f}")
      message(FATAL_ERROR "mTLS file not found: ${f}\n"
        "Create it with: python scripts/device_pki.py issue <device-id>")
    endif()
  endforeach()
  set(gen_dir ${ZEPHYR_BINARY_DIR}/include/generated/zephyr_a_client)
  generate_inc_file_for_target(${target} ${cert} ${gen_dir}/client_cert.inc)
  generate_inc_file_for_target(${target} ${key} ${gen_dir}/client_key.inc)
  file(WRITE ${gen_dir}/client_cred.h
"/* Generated by app/cmake/client_cert.cmake - do not edit. */
static const uint8_t client_cert_der[] = {
#include \"zephyr_a_client/client_cert.inc\"
};
static const uint8_t client_key_der[] = {
#include \"zephyr_a_client/client_key.inc\"
};
")
endfunction()
