# Zephyr_A - sysbuild Kconfig
#
# Sysbuild builds several images in one go: the MCUboot bootloader (default
# for esp32c6_devkitc), the HP-core application and the LP-core image in
# remote/ (part 9).
#
# SPDX-License-Identifier: Apache-2.0

source "share/sysbuild/Kconfig"

config ULP_REMOTE_BOARD
	string
	default "esp32c6_devkitc/esp32c6/lpcore" if $(BOARD) = "esp32c6_devkitc"
	help
	  Board target of the LP-core image (app/remote), as in Zephyr's
	  samples/boards/espressif/ulp/lp_core/*.
